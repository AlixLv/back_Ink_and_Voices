generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id String @id @default(uuid())
  email String @unique
  username String @unique
  password String
  role role @default(user)
  book_suggestions book[] 
  created_at DateTime @default(now()) 
  updated_at DateTime @updatedAt 
  validations book_validation[] 

  @@map("user")
}

enum role {
  user
  admin
}

model book { 
  id Int @id @default(autoincrement())
  type_id Int
  type type @relation(fields: [type_id], references: [id])
  title String
  author String
  publishing_house String
  publication_year String?
  themes theme_book[]
  resume String? @db.Text 
  reference_link String?
  short_description String @db.Text
  status status @default(pending)
  user_id String
  user user @relation(fields: [user_id], references:[id])
  created_at DateTime @default(now())
  validations book_validation[]

  @@unique([author, title])
}

enum status {
  validated
  refused
  pending
}

model type {
  id Int @id @default(autoincrement())
  type_name String @unique
  url_image String?
  books book[]
  created_at  DateTime @default(now())
}
model theme {
  id Int @id @default(autoincrement())
  theme_name String @unique
  books theme_book[]
  created_at DateTime @default(now())
}
model theme_book {
  book_id Int
  book book @relation(fields: [book_id], references: [id])

  theme_id Int
  theme theme @relation(fields: [theme_id], references: [id])

  created_at DateTime @default(now())
  
  @@id([book_id, theme_id])
}

model book_validation {
  id Int @id @default(autoincrement())
  book_id Int
  book book @relation(fields: [book_id], references: [id])
  admin_id String
  admin user @relation(fields: [admin_id], references: [id])
  validation_date DateTime @default(now())
  created_at DateTime @default(now())
  status status
  comment String? @db.Text
}
