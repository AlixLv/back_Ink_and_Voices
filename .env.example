# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PW=postgres
POSTGRES_DB=ink_and_voices

# --- pgAdmin (UI sur http://localhost:5050) ---
PGADMIN_MAIL=admin@example.com
PGADMIN_PW=admin

# --- URLs de connexion ---
# IMPORTANT : depuis un conteneur (service "dev"), l'hôte de la base est le NOM
# DU SERVICE "postgres", pas "localhost". "localhost" ne marcherait que pour une
# app lancée directement sur la machine hôte.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ink_and_voices
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ink_and_voices

# --- Auth ---
JWT_SECRET=change-me-en-prod